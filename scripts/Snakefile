# The chain from the CSD metadata to the corpus: the metadata of every CSD entry, exported with
# the CSD Python API (which needs a CCDC licence, see the README), then the open-access papers of
# the CSD entries, downloaded from PubMed Central (PMC), then parsed to Markdown. The extraction
# (`data/extractions.parquet`) and the Acta E collection (`data/viz/acta-e-papers.jsonl.gz`) are
# made elsewhere and taken as given, so the figures of the README (`plot_extraction`, `example`)
# and the dataset of the website (`release`) are not part of `all`.
#
# This file is kept for what it documents -- which script produces which file from which input, in
# the one form that stays true because it is what actually runs. All the logic is in the scripts;
# nothing here does anything but name inputs and outputs.
#
# The download should not be rebuilt casually: it takes hours and 200 GB. Snakemake only reruns a
# rule whose output is missing or older than its input, so leave `metadata.parquet` in place.
#
# Run from the repo root, where every path below is anchored:
#
#     pixi run snakemake -s scripts/Snakefile -n          # what would run
#     pixi run snakemake -s scripts/Snakefile -j1 all     # the corpus

PAPERS = "data/papers"
DATA = "data/textal"


rule all:
    default_target: True
    input:
        f"{PAPERS}/parsed.parquet",


# The CSD Python API lives in its own pixi environment, `csd`.
rule metadata:
    output:
        "data/raw/csd_metadata.full.parquet",
    shell:
        "pixi run -e csd python scripts/runs/csd/s0_metadata.py"


rule download:
    input:
        "data/raw/csd_metadata.full.parquet",
    output:
        f"{PAPERS}/metadata.parquet",
    shell:
        "python scripts/runs/bib/s0_download.py"


rule parse:
    input:
        f"{PAPERS}/metadata.parquet",
    output:
        f"{PAPERS}/parsed.parquet",
    shell:
        "python scripts/runs/bib/s1_parse.py"


rule plot_extraction:
    input:
        "data/extractions.parquet",
        f"{PAPERS}/metadata.parquet",
        "data/raw/csd_metadata.full.parquet",
    output:
        "assets/results.png",
    shell:
        "python scripts/analysis/s0_extraction_plots.py"


# The example record of the README; it needs Chrome, so it is not part of `all`.
rule example:
    input:
        "data/extractions.parquet",
        "data/viz/csd_drugs_with_paper.parquet",
        "data/raw/csd_metadata.full.parquet",
        f"{PAPERS}/metadata.parquet",
    output:
        "assets/example.png",
    shell:
        "python scripts/analysis/s0_example_figure.py"


# The tables of the website. The papers of the other journals are listed with their PMC licence,
# and their bibliography is fetched from Europe PMC and Crossref. The tables take the texts and
# authors from the parsed corpus, release a paper's text and publisher files only under a
# Creative Commons licence, and read the CSD metadata only to remove what the records copied
# from it. `release` packs the publisher files (`data/publisher-cache/` is copied from the
# archive of PMC packages and taken as given).
rule targets:
    input:
        sections="data/viz/acta-e-papers.jsonl.gz",
        extractions="data/extractions.parquet",
        metadata=f"{PAPERS}/metadata.parquet",
    output:
        "data/viz/publisher-targets.json",
    shell:
        "python scripts/runs/viz/s0_targets.py --sections {input.sections}"
        " --extractions {input.extractions} --metadata {input.metadata} --output {output}"


rule bibliography:
    input:
        "data/viz/publisher-targets.json",
    output:
        "data/viz/publisher-bibliography.json",
    shell:
        "python scripts/runs/viz/s1_bibliography.py --targets {input} --output {output}"


rule tables:
    input:
        sections="data/viz/acta-e-papers.jsonl.gz",
        extractions="data/extractions.parquet",
        csd="data/raw/csd_metadata.full.parquet",
        bibliography="data/viz/publisher-bibliography.json",
        linkage="data/viz/publisher-targets.json",
        parsed=f"{PAPERS}/parsed.parquet",
    output:
        f"{DATA}/entries.parquet",
        f"{DATA}/papers.parquet",
        f"{DATA}/snapshot.json",
    shell:
        "python scripts/runs/viz/s2_assets.py --sections {input.sections}"
        " --extractions {input.extractions} --csd {input.csd}"
        " --bibliography {input.bibliography} --linkage {input.linkage}"
        " --papers {PAPERS} --cache data/publisher-cache --output {DATA}"


rule release:
    input:
        f"{DATA}/papers.parquet",
    output:
        f"{DATA}/README.md",
    shell:
        "python scripts/runs/viz/s3_release.py --cache data/publisher-cache --output {DATA}"
