# The chain from the CSD metadata to the figures of the README: the metadata of every CSD entry,
# exported with the CSD Python API (which needs a CCDC licence, see the README), then the
# open-access papers of the CSD entries, downloaded from PubMed Central (PMC), then parsed to
# Markdown, then plotted. The tables of the website (`assets`) are not part of `all`, since their
# inputs in `data/viz/` are made by hand.
#
# This file is kept for what it documents -- which script produces which file from which input, in
# the one form that stays true because it is what actually runs. All the logic is in the scripts;
# nothing here does anything but name inputs and outputs.
#
# The download should not be rebuilt casually: it takes hours and 200 GB. Snakemake only reruns a
# rule whose output is missing or older than its input, so leave `metadata.parquet` in place.
#
# Run from the repo root, where every path below is anchored:
#
#     pixi run snakemake -s scripts/Snakefile -n          # what would run
#     pixi run snakemake -s scripts/Snakefile -j1 all     # the figures, and the data they need

PAPERS = "data/papers"
PLOTS = ["years", "downloads"]


rule all:
    default_target: True
    input:
        expand("docs/assets/{plot}.png", plot=PLOTS),


# The CSD Python API lives in its own pixi environment, `csd`.
rule metadata:
    output:
        "data/raw/csd_metadata.full.parquet",
    shell:
        "pixi run -e csd python scripts/runs/csd/s0_metadata.py"


rule download:
    input:
        "data/raw/csd_metadata.full.parquet",
    output:
        f"{PAPERS}/metadata.parquet",
    shell:
        "python scripts/runs/bib/s0_download.py"


rule parse:
    input:
        f"{PAPERS}/metadata.parquet",
    output:
        f"{PAPERS}/parsed.parquet",
    shell:
        "python scripts/runs/bib/s1_parse.py"


rule plot_papers:
    input:
        f"{PAPERS}/metadata.parquet",
        f"{PAPERS}/parsed.parquet",
    output:
        expand("docs/assets/{plot}.png", plot=PLOTS),
    shell:
        "python scripts/analysis/s0_paper_plots.py"


rule assets:
    input:
        "data/raw/csd_metadata.full.parquet",
        f"{PAPERS}/metadata.parquet",
        f"{PAPERS}/parsed.parquet",
        "data/viz/csd_drugs_with_paper.parquet",
        "data/viz/priority-extractions.parquet",
    output:
        "src/viz/assets/entries.parquet",
        "src/viz/assets/extractions.parquet",
        "src/viz/assets/stats.json",
    shell:
        "python scripts/runs/viz/s0_assets.py"
